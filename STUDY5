def obter_natureza(nome_coluna):
    col_up = nome_coluna.strip().upper()
    prefixo = col_up.split("_")[0] if "_" in col_up else col_up[:2]
    return MAPA_NATUREZAS.get(prefixo, "OUTROS")

def formatar_where_hive(particao_str):
    if not particao_str:
        return ""
    filtros = []
    for bloco in particao_str.split("/"):
        if "=" in bloco:
            k, v = bloco.split("=", 1)
            filtros.append(f"{k.strip()} = '{v.strip()}'")
    return " AND ".join(filtros)

