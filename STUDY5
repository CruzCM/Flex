                    colunas_lideres.add(col_name)
                indices_dict.setdefault(idx_name, []).append(f"{col_name}(#{pos_idx})")
                
            tamanho_linha = 0
            possui_lob = False
            colunas_particao_candidatas = []
            colunas_temporais = []
            
            # 4. Leitura Controlada para Extração de Valores Únicos
