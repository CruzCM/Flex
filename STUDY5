                print(f"       - {idx_n}: {', '.join(idx_cols)}")
                
            print(f"\n⚙️ PARÂMETROS SUGERIDOS DE ENGENHARIA JDBC:")
            print(f"   • fetchsize: {fetchsize}")
            print(f"   • numPartitions: {num_parts}")
