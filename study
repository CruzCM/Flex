# 2. DICIONÁRIO DE NATUREZAS (BASEADO NO NATUREZA.TXT)
# ==============================================================================
MAPA_NATUREZAS = {
    "CD": ("CÓDIGO", "Identificador estruturado de componentes"),
    "NR": ("NÚMERO", "Identificação numérica formada apenas por dígitos"),
    "VL": ("VALOR", "Importância monetária expressa em moeda"),
    "QT": ("QUANTIDADE", "Número de unidades de determinado objeto"),
    "PC": ("PERCENTUAL", "Relação percentual entre grandezas"),
    "DT": ("DATA", "Indicação de dia, mês e ano"),
    "TS": ("TIMESTAMP", "Data, hora, minuto e segundos"),
    "HR": ("HORÁRIO", "Indicação de hora, minuto e segundo"),
    "HH": ("HORA", "Período de tempo em horas"),
    "DD": ("DIA", "Período de tempo de 24 horas"),
    "MM": ("MÊS", "Período de tempo de 30 dias"),
    "AA": ("ANO", "Período de tempo equivalente a 365 dias"),
    "IN": ("INDICADOR", "Indicador booleano (Sim ou Não / 'S' ou 'N')"),
    "TX": ("TEXTO", "Escrita livre ou esclarecimentos"),
    "NM": ("NOME", "Designação textual de pessoa ou objeto"),
    "SG": ("SIGLA", "Abreviatura composta por letras"),
    "IC": ("ÍNDICE", "Relação entre grandezas numéricas"),
    "DV": ("DÍGITO VERIFICADOR", "Controle de consistência numérica"),
    "DA": ("DADO ANONIMIZADO", "Dado desvinculado de pessoa natural (LGPD)"),
    "BL": ("BLOB", "Binary Large Object"),
    "JS": ("JSON", "Estrutura serializada em formato JSON"),
}
PII_KEYWORDS = ["CPF", "CNPJ", "NOME", "NM_", "EMAIL", "TELEFONE", "TEL", "CARTAO", "CRT", "ENDERECO", "CONTA", "CT_TITR"]
def classificar_natureza_coluna(nome_coluna: str):
    col_up = nome_coluna.strip().upper()
    prefixo = col_up.split("_")[0] if "_" in col_up else col_up[:2]
    if prefixo in MAPA_NATUREZAS:
        natureza, desc_nat = MAPA_NATUREZAS[prefixo]
    else:
        natureza, desc_nat = ("OUTROS", "Prefixo não padronizado")
    eh_pii = any(k in col_up for k in PII_KEYWORDS) and not col_up.startswith("DA_")
    return natureza, desc_nat, eh_pii
