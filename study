for tab_info in TABELAS_CATALOGO:
    sch = tab_info["schema"]
    tbl = tab_info["tabela"]
    tipo_origem = tab_info["tipo"]
    categoria_tab = tab_info["categoria"]
    prio = tab_info["prioridade"]
    desc_tab = tab_info["descricao"]
    tabela_fqn = f"{sch}.{tbl}"
    
    print(f"\n🚀 Diagnosticando [{tipo_origem}] {tabela_fqn:<32} (Prioridade {prio} - {categoria_tab})...")
    
    try:
        if tipo_origem == "DB2":
            # 1. Estatísticas instantâneas do SYSIBM.SYSTABLES (Sem custo de IO)
            sql_tab = f"SELECT TYPE, CARDF FROM SYSIBM.SYSTABLES WHERE CREATOR = '{sch}' AND NAME = '{tbl}'"
            meta_tab = conector_db2.sql(sql_tab).collect()
            
            if not meta_tab:
                print(f"   ⚠️ Tabela não encontrada no catálogo SYSIBM: {tabela_fqn}")
                continue
                
            cardf = float(meta_tab[0]["CARDF"] or -1)
            tipo_obj = str(meta_tab[0]["TYPE"] or "T").strip()
            
            # 2. Metadados de Colunas em SYSIBM.SYSCOLUMNS
            sql_cols = f"""
                SELECT NAME, COLNO, COLTYPE, LENGTH, NULLS 
                FROM SYSIBM.SYSCOLUMNS 
                WHERE TBCREATOR = '{sch}' AND TBNAME = '{tbl}' 
                ORDER BY COLNO
            """
            cols = conector_db2.sql(sql_cols).collect()
            
            # 3. Índices Líderes em SYSIBM.SYSINDEXES / SYSKEYS
            sql_idx = f"""
                SELECT K.COLNAME 
                FROM SYSIBM.SYSINDEXES I
                INNER JOIN SYSIBM.SYSKEYS K ON I.CREATOR = K.IXCREATOR AND I.NAME = K.IXNAME
                WHERE I.TBCREATOR = '{sch}' AND I.TBNAME = '{tbl}' AND K.COLSEQ = 1
            """
            idx_rows = conector_db2.sql(sql_idx).collect()
            indices_lider = {str(r["COLNAME"]).strip().upper() for r in idx_rows}
            
            tamanho_linha = 0
            cols_temporais = []
            cols_particao = []
            cols_pii_detectadas = []
            
            for c in cols:
                nome_c = str(c["NAME"]).strip().upper()
                tipo_c = str(c["COLTYPE"] or "").strip().upper()
                null_c = str(c["NULLS"] or "").strip().upper()
                tam_c = int(c["LENGTH"] or 0)
                
                tamanho_linha += conector_db2._estimar_tamanho_coluna(tipo_c, tam_c)
                natureza, desc_nat, eh_pii = classificar_natureza_coluna(nome_c)
                
                if tipo_c in {"DATE", "TIMESTAMP", "TIMESTMP"}:
                    cols_temporais.append(nome_c)
                if null_c == "N" and nome_c in indices_lider:
                    cols_particao.append(nome_c)
                if eh_pii:
                    cols_pii_detectadas.append(nome_c)
                
                sumario_colunas.append({
                    "TABELA_FQN": tabela_fqn,
                    "ORIGEM": "DB2",
                    "POSICAO": int(c["COLNO"]),
                    "COLUNA": nome_c,
                    "NATUREZA_SIGLA": nome_c.split("_")[0] if "_" in nome_c else "OUTROS",
                    "NATUREZA_DESC": natureza,
                    "TIPO_DB2": tipo_c,
                    "TAMANHO_BYTES": tam_c,
                    "ACEITA_NULO": null_c == "Y",
                    "INDICE_LIDER": nome_c in indices_lider,
                    "ALERTA_PII_LGPD": eh_pii,
                })
            
            # Sugestão de Engenharia de Dados
            fetchsize_sug = 1000 if tamanho_linha > 4096 else 10000
            tabela_bilionaria = cardf > 100_000_000
            num_parts_sug = min(16, max(1, int(cardf // 2_000_000))) if (cols_particao and cardf > 0) else 1
            estrategia = "PARALELA_JDBC" if num_parts_sug > 1 else "SIMPLES_JDBC"
            
            sumario_tabelas.append({
                "TABELA_FQN": tabela_fqn,
                "ORIGEM": "DB2",
                "CATEGORIA": categoria_tab,
                "PRIORIDADE": prio,
                "ESTIMATIVA_LINHAS": int(cardf) if cardf >= 0 else None,
                "TABELA_BILIONARIA": tabela_bilionaria,
                "QTD_COLUNAS": len(cols),
                "TAMANHO_LINHA_BYTES": tamanho_linha,
                "COLUNAS_INDICE_PARTICAO": ", ".join(cols_particao) if cols_particao else "Nenhuma",
                "COLUNAS_TEMPORAIS": ", ".join(cols_temporais) if cols_temporais else "Nenhuma",
                "FETCHSIZE_SUGERIDO": fetchsize_sug,
                "PARTICOES_SUGERIDAS": num_parts_sug,
                "ESTRATEGIA_LEITURA": estrategia,
                "QTD_PII_DETECTADA": len(cols_pii_detectadas),
                "DESCRICAO_NEGOCIAL": desc_tab,
            })
            
            # 4. Amostragem Segura de Domínios para Tabelas Pequenas/Médias (Sem risco para as bilionárias)
            if cardf > 0 and cardf <= 5_000_000:
                try:
                    df_sample = conector_db2.limit(sch, tbl, limit=100)
                    for col_item in sumario_colunas:
                        if col_item["TABELA_FQN"] == tabela_fqn and col_item["NATUREZA_SIGLA"] in {"CD", "IN"}:
                            c_name = col_item["COLUNA"]
                            if c_name in df_sample.columns:
                                dist_vals = [str(r[0]) for r in df_sample.select(c_name).distinct().limit(10).collect() if r[0] is not None]
                                amostras_dominios.append({
                                    "TABELA_FQN": tabela_fqn,
                                    "COLUNA": c_name,
                                    "VALORES_AMOSTRA": ", ".join(dist_vals[:8])
                                })
                except Exception:
                    pass
        elif tipo_origem == "HIVE":
            # Hive: Inspeciona via Spark Nativo
            df_hive = spark.table(tabela_fqn)
            cols_hive = df_hive.dtypes
            
            try:
                parts_hive = [r[0] for r in spark.sql(f"SHOW PARTITIONS {tabela_fqn}").collect()]
            except Exception:
                parts_hive = []
                
            cols_pii_hive = []
            for idx_h, (c_nome, c_tipo) in enumerate(cols_hive, start=1):
                nome_up = c_nome.upper()
                natureza, desc_nat, eh_pii = classificar_natureza_coluna(nome_up)
                if eh_pii:
                    cols_pii_hive.append(nome_up)
                    
                sumario_colunas.append({
                    "TABELA_FQN": tabela_fqn,
                    "ORIGEM": "HIVE",
                    "POSICAO": idx_h,
                    "COLUNA": nome_up,
                    "NATUREZA_SIGLA": nome_up.split("_")[0] if "_" in nome_up else "OUTROS",
                    "NATUREZA_DESC": natureza,
                    "TIPO_DB2": c_tipo.upper(),
                    "TAMANHO_BYTES": 8,
                    "ACEITA_NULO": True,
                    "INDICE_LIDER": False,
                    "ALERTA_PII_LGPD": eh_pii,
                })
                
            sumario_tabelas.append({
                "TABELA_FQN": tabela_fqn,
                "ORIGEM": "HIVE",
                "CATEGORIA": categoria_tab,
                "PRIORIDADE": prio,
                "ESTIMATIVA_LINHAS": None,
                "TABELA_BILIONARIA": True,
                "QTD_COLUNAS": len(cols_hive),
                "TAMANHO_LINHA_BYTES": len(cols_hive) * 16,
                "COLUNAS_INDICE_PARTICAO": "PARTITION PRUNING (HIVE)",
                "COLUNAS_TEMPORAIS": "DT_MES_EXEA / DT_REF",
                "FETCHSIZE_SUGERIDO": 10000,
                "PARTICOES_SUGERIDAS": max(1, len(parts_hive)),
                "ESTRATEGIA_LEITURA": "NATIVE_SPARK_HIVE",
                "QTD_PII_DETECTADA": len(cols_pii_hive),
                "DESCRICAO_NEGOCIAL": desc_tab,
            })
    except Exception as exc:
        print(f"   ❌ Erro ao explorar {tabela_fqn}: {exc}")
