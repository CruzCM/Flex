]

for t in sumario_executivo_tabelas:
    lin = f"{t['ESTIMATIVA_LINHAS']:,}" if t['ESTIMATIVA_LINHAS'] else "N/A (Hive)"
    linhas_md.append(
        f"| `{t['TABELA_FQN']}` | `{t['ORIGEM']}` | {t['PORTE']} | {lin} | {t['QTD_COLUNAS']} | {t['TAMANHO_LINHA_BYTES']} B | {t['NPARTS']} | `{t['ESTRATEGIA']}` |"
    )

linhas_md.append("\n## 2. Detalhamento Físico e Valores Únicos por Tabela\n")
tabela_atual = ""
for col in detalhe_completo_colunas:
    if col["TABELA"] != tabela_atual:
        tabela_atual = col["TABELA"]
        linhas_md.append(f"\n### 📦 Tabela `{tabela_atual}` ({col['ORIGEM']})\n")
        linhas_md.append("| # | Coluna | Natureza | Tipo DB2 | Null | Índice Líder | Valores Únicos Observados |")
        linhas_md.append("|:---:|---|:---:|:---:|:---:|:---:|---|")
        
    linhas_md.append(
        f"| {col['POS']} | `{col['COLUNA']}` | `{col['NATUREZA']}` | `{col['TIPO_DB2']}` | {col['NULLABLE']} | {col['INDICE_LIDER']} | {col['VALORES_UNICOS']} |"
    )

with open(caminho_md, "w", encoding="utf-8") as f_md:
    f_md.write("\n".join(linhas_md))

print("\n" + "=" * 115)
print(f"✅ RELATÓRIO MARKDOWN SALVO EM: {caminho_md}")
print(f"✅ METADADOS JSON SALVOS EM:   {caminho_json}")
