# 2. Exporta Relatório Markdown Completo
caminho_md = "./source/estudo_engenharia_catalogo_completo.md"
linhas_md = [
    "# Relatório Técnico de Engenharia de Dados: Estudo Completo do Catálogo GFP",
    f"\n> **Data de Geração:** {datetime.datetime.now().strftime('%d/%m/%Y %H:%M:%S')} · **Fontes:** IBM DB2 (`SYSIBM`) & Apache Hive",
    "\n## 1. Resumo Executivo das Tabelas Estudadas\n",
