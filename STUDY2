# Dicionário oficial de prefixos de colunas (NATUREZA.txt)
MAPA_NATUREZAS = {
    "CD": "CÓDIGO", "NR": "NÚMERO", "VL": "VALOR", "QT": "QUANTIDADE", "PC": "PERCENTUAL",
    "DT": "DATA", "TS": "TIMESTAMP", "HR": "HORÁRIO", "HH": "HORA", "DD": "DIA",
    "MM": "MÊS", "AA": "ANO", "IN": "INDICADOR", "TX": "TEXTO", "NM": "NOME",
    "SG": "SIGLA", "IC": "ÍNDICE", "DV": "DÍGITO VERIFICADOR", "DA": "DADO ANONIMIZADO",
    "BL": "BLOB", "JS": "JSON",
}

# Colunas de cardinalidade contínua onde distinct é irrelevante
COLUNAS_ALTA_CARDINALIDADE = {
    "CD_CLI", "NR_CPF", "NR_CPF_CNPJ_TITR", "NR_TRAN_INST_PCT", "CD_HASH_AGPT_TRAN",
    "TX_DCR_TRAN", "TX_CMPR_DCR_TRAN", "TX_DCR_TRAN_OGNL", "TX_REGRA_CLIENTE",
    "TX_DCR_TRAN_PSZD", "VL_TRAN", "VL_REN_INFD", "VL_SDO_OPB", "VL_TOT_FAT_CRT",
    "VL_PGTO_MIN_FAT", "VL_RDPR", "TS_INCL_TRAN", "TS_ATL_TRAN", "TS_INCL", "TS_ATL",
    "DT_TRAN", "HR_TRAN", "DT_REF", "DT_VCT_FAT_CRT", "TS_ATL_REN_INFD", "TS_ATL_SDO_OPB"
}

def obter_natureza(nome_coluna):
    col_up = nome_coluna.strip().upper()
    prefixo = col_up.split("_")[0] if "_" in col_up else col_up[:2]
    return MAPA_NATUREZAS.get(prefixo, "OUTROS")

# ==============================================================================
# 2. MOTOR UNIFICADO DE ENGENHARIA DE DADOS
# ==============================================================================
sumario_executivo_tabelas = []
detalhe_completo_colunas = []

print("=" * 115)
print(f"{'MOTOR UNIFICADO DE ENGENHARIA DE DADOS: DIAGNÓSTICO INDIVIDUAL & VALORES ÚNICOS':^115}")
print("=" * 115)

for item in TABELAS_ESTUDO_COMPLETO:
    sch = item["schema"]
    tbl = item["tabela"]
    tipo_origem = item["tipo"]
    porte = item["porte"]
    modo_amostra = item["modo_amostra"]
    tabela_fqn = f"{sch}.{tbl}"
    
    print("\n" + "=" * 115)
    print(f"📦 TABELA: {tabela_fqn:<38} | ORIGEM: {tipo_origem:<5} | PORTE: {porte:<10} | ESTRATÉGIA: {modo_amostra}")
    print("=" * 115)
    
    try:
        if tipo_origem == "DB2":
            # --- 1. Metadados Físicos (SYSIBM.SYSTABLES) ---
            sql_tab = f"SELECT TYPE, CARDF, NPAGES FROM SYSIBM.SYSTABLES WHERE CREATOR = '{sch}' AND NAME = '{tbl}'"
            meta_tab = conector_db2.sql(sql_tab).collect()
            
            if not meta_tab:
                print(f"⚠️ Tabela {tabela_fqn} não localizada em SYSIBM.SYSTABLES.")
                continue
                
            cardf = float(meta_tab[0]["CARDF"] or -1)
            npages = int(meta_tab[0]["NPAGES"] or 0)
            tipo_obj = str(meta_tab[0]["TYPE"] or "T").strip()
            
            # --- 2. Metadados de Colunas (SYSIBM.SYSCOLUMNS) ---
            sql_cols = f"""
                SELECT NAME, COLNO, COLTYPE, LENGTH, NULLS 
                FROM SYSIBM.SYSCOLUMNS 
                WHERE TBCREATOR = '{sch}' AND TBNAME = '{tbl}' 
                ORDER BY COLNO
            """
            cols = conector_db2.sql(sql_cols).collect()
            
            # --- 3. Índices e Chaves (SYSIBM.SYSINDEXES / SYSKEYS) ---
            sql_idx = f"""
                SELECT I.NAME AS NOME_INDICE, K.COLNAME AS COLUNA, K.COLSEQ AS POSICAO_NO_INDICE, I.UNIQUERULE AS REGRA_UNICIDADE
                FROM SYSIBM.SYSINDEXES I
                INNER JOIN SYSIBM.SYSKEYS K ON I.CREATOR = K.IXCREATOR AND I.NAME = K.IXNAME
                WHERE I.TBCREATOR = '{sch}' AND I.TBNAME = '{tbl}'
                ORDER BY I.NAME, K.COLSEQ
            """
            idx_rows = conector_db2.sql(sql_idx).collect()
            
            indices_dict = {}
            colunas_lideres = set()
            for r in idx_rows:
                idx_name = str(r["NOME_INDICE"]).strip()
                col_name = str(r["COLUNA"]).strip().upper()
                pos_idx = int(r["POSICAO_NO_INDICE"])
                if pos_idx == 1:
                    colunas_lideres.add(col_name)
                indices_dict.setdefault(idx_name, []).append(f"{col_name}(#{pos_idx})")
                
            tamanho_linha = 0
            possui_lob = False
            colunas_particao_candidatas = []
            colunas_temporais = []
            
            # --- 4. Leitura Controlada para Extração de Valores Únicos ---
            view_temp_nome = f"vw_diag_{tbl.lower()}"
            if modo_amostra == "FULL":
                df_dados = conector_db2.sql(f"SELECT * FROM {sch}.{tbl}")
            else:
                # Amostragem segura de 100.000 linhas via JDBC com zero lock
                df_dados = conector_db2.sql(f"SELECT * FROM {sch}.{tbl} FETCH FIRST 100000 ROWS ONLY")
                
            df_dados.createOrReplaceTempView(view_temp_nome)
            
            tabela_colunas_saida = []
            
            for c in cols:
                nome_c = str(c["NAME"]).strip().upper()
                tipo_c = str(c["COLTYPE"] or "").strip().upper()
                null_c = str(c["NULLS"] or "").strip().upper()
                tam_c = int(c["LENGTH"] or 0)
                natureza = obter_natureza(nome_c)
                
                tam_est = conector_db2._estimar_tamanho_coluna(tipo_c, tam_c)
                tamanho_linha += tam_est
                
                if tipo_c in {"BLOB", "CLOB", "XML", "LONGVAR"}:
                    possui_lob = True
                if tipo_c in {"DATE", "TIMESTAMP", "TIMESTMP"}:
                    colunas_temporais.append(nome_c)
                if null_c == "N" and nome_c in colunas_lideres:
                    colunas_particao_candidatas.append(nome_c)
                
                # Extrai os valores únicos da view Spark em memória
                if nome_c in COLUNAS_ALTA_CARDINALIDADE or tipo_c in {"BLOB", "CLOB", "XML"}:
                    valores_str = "[ALTA CARDINALIDADE / CHAVE / TEXTO]"
                else:
                    try:
                        distinct_rows = spark.sql(f"""
                            SELECT DISTINCT {nome_c} 
                            FROM {view_temp_nome} 
                            ORDER BY {nome_c} NULLS LAST 
                            LIMIT 40
                        """).collect()
                        
                        valores = []
                        for r in distinct_rows:
                            val = r[0]
                            if val is None:
                                valores.append("NULL")
                            elif isinstance(val, str):
                                valores.append(f"'{val.strip()}'")
                            else:
                                valores.append(str(val))
                                
                        valores_str = ", ".join(valores) if valores else "[VAZIO]"
                        if len(valores) >= 40:
                            valores_str += " ... (Top 40 exibidos)"
                    except Exception as e_dist:
                        valores_str = f"[ERRO: {e_dist}]"
                
                col_info = {
                    "POS": int(c["COLNO"]),
                    "COLUNA": nome_c,
                    "NATUREZA": natureza,
                    "TIPO_DB2": tipo_c,
                    "BYTES": tam_c,
                    "NULLABLE": null_c,
                    "INDICE_LIDER": "SIM" if nome_c in colunas_lideres else "NAO",
                    "VALORES_UNICOS": valores_str,
                }
                tabela_colunas_saida.append(col_info)
                detalhe_completo_colunas.append({"TABELA": tabela_fqn, "ORIGEM": "DB2", **col_info})
            
            # --- 5. Cálculo dos Parâmetros de Leitura JDBC ---
            fetchsize = 1000 if (possui_lob or tamanho_linha > 4096) else 10000
            num_parts = min(16, max(1, int(cardf // 2_000_000))) if (colunas_particao_candidatas and cardf > 0) else 1
            estrategia_leitura = "PARALELA_JDBC" if num_parts > 1 else "SIMPLES_JDBC"
            
            print(f"📊 METADADOS FÍSICOS DE ARMAZENAMENTO:")
            print(f"   • Volumetria Estimada (CARDF): {int(cardf):,}" if cardf >= 0 else "   • Volumetria Estimada: Desconhecida")
            print(f"   • Tamanho Estimado de Linha: {tamanho_linha} bytes | Páginas de Disco: {npages:,} | Contém LOBs: {'SIM' if possui_lob else 'NÃO'}")
            print(f"   • Coluna(s) Líder de Índice para Partição JDBC: {colunas_particao_candidatas or 'Nenhuma'}")
            print(f"   • Colunas Temporais para Pushdown WHERE: {colunas_temporais or 'Nenhuma'}")
            print(f"   • Índices Físicos Catalogados ({len(indices_dict)}):")
            for idx_n, idx_cols in list(indices_dict.items())[:4]:
                print(f"       - {idx_n}: {', '.join(idx_cols)}")
                
            print(f"\n⚙️ PARÂMETROS SUGERIDOS DE ENGENHARIA JDBC:")
            print(f"   • fetchsize: {fetchsize}")
            print(f"   • numPartitions: {num_parts}")
            print(f"   • isolationLevel: READ_UNCOMMITTED (WITH UR)")
            print(f"   • partitionColumn: {colunas_particao_candidatas[0] if colunas_particao_candidatas else 'None'}")
            
            # Exibe a matriz de colunas com valores únicos
            print(f"\n📋 ESTRUTURA FÍSICA & VALORES ÚNICOS OBSERVADOS ({len(cols)} colunas):")
            df_out_tab = spark.createDataFrame(tabela_colunas_saida)
            df_out_tab.select("POS", "COLUNA", "NATUREZA", "TIPO_DB2", "NULLABLE", "INDICE_LIDER", "VALORES_UNICOS").show(60, truncate=False)
            
            # --- 6. Payload de Dados Brutos ---
            if porte == "PEQUENA":
                print(f"\n🔍 PAYLOAD BRUTO COMPLETO (100% DAS LINHAS):")
                df_dados.show(100, truncate=False)
            elif porte == "MEDIA":
                print(f"\n🔍 PAYLOAD BRUTO (AMOSTRA DE 10 LINHAS):")
                df_dados.show(10, truncate=False)
            elif porte in {"GRANDE", "BILIONARIA"}:
                print(f"\n🔍 PAYLOAD BRUTO (PARCIMÔNIA: FETCH FIRST 5 ROWS ONLY):")
                df_dados.limit(5).show(5, truncate=False)
                
            sumario_executivo_tabelas.append({
                "TABELA_FQN": tabela_fqn,
                "ORIGEM": "DB2",
                "PORTE": porte,
                "ESTIMATIVA_LINHAS": int(cardf) if cardf >= 0 else None,
                "QTD_COLUNAS": len(cols),
                "TAMANHO_LINHA_BYTES": tamanho_linha,
                "COLUNAS_PARTICAO": ", ".join(colunas_particao_candidatas) if colunas_particao_candidatas else "Nenhuma",
                "FETCHSIZE": fetchsize,
                "NPARTS": num_parts,
                "ESTRATEGIA": estrategia_leitura,
            })

        elif tipo_origem == "HIVE":
            # --- 7. Diagnóstico Especializado para Hive ---
            df_hive = spark.table(tabela_fqn)
            cols_hive = df_hive.dtypes
            
            try:
                particoes = [r[0] for r in spark.sql(f"SHOW PARTITIONS {tabela_fqn}").collect()]
                part_recente = particoes[-1] if particoes else None
            except Exception:
                particoes = []
                part_recente = None
                
            print(f"📊 METADADOS FÍSICOS HIVE:")
            print(f"   • Formato de Armazenamento: Hive/Parquet Nativo")
            print(f"   • Total de Colunas: {len(cols_hive)}")
            print(f"   • Partições Detectadas ({len(particoes)}): {particoes[:4]} ...")
            print(f"   • Estratégia de Leitura: NATIVE_SPARK_HIVE com Partition Pruning")
            
            query_hive_sample = f"SELECT * FROM {tabela_fqn} WHERE {part_recente} LIMIT 100000" if part_recente else f"SELECT * FROM {tabela_fqn} LIMIT 100000"
            df_hive_sample = spark.sql(query_hive_sample)
            df_hive_sample.createOrReplaceTempView("vw_diag_hive_sample")
            
            tabela_colunas_hive = []
            for idx_h, (c_nome, c_tipo) in enumerate(cols_hive, start=1):
                nome_c = c_nome.upper()
                natureza = obter_natureza(nome_c)
                
                if nome_c in COLUNAS_ALTA_CARDINALIDADE:
                    valores_str = "[ALTA CARDINALIDADE / CHAVE]"
                else:
                    try:
                        distinct_rows = spark.sql(f"SELECT DISTINCT {nome_c} FROM vw_diag_hive_sample ORDER BY {nome_c} NULLS LAST LIMIT 40").collect()
                        valores = [str(r[0]) if r[0] is not None else "NULL" for r in distinct_rows]
                        valores_str = ", ".join(valores)
                    except Exception as eh:
                        valores_str = f"[ERRO: {eh}]"
                        
                col_info_h = {
                    "POS": idx_h,
                    "COLUNA": nome_c,
                    "NATUREZA": natureza,
                    "TIPO_DB2": c_tipo.upper(),
                    "BYTES": 8,
                    "NULLABLE": "Y",
                    "INDICE_LIDER": "NAO",
                    "VALORES_UNICOS": valores_str,
                }
                tabela_colunas_hive.append(col_info_h)
                detalhe_completo_colunas.append({"TABELA": tabela_fqn, "ORIGEM": "HIVE", **col_info_h})
                
            print(f"\n📋 ESTRUTURA FÍSICA & VALORES ÚNICOS HIVE ({len(cols_hive)} colunas):")
            df_out_h = spark.createDataFrame(tabela_colunas_hive)
            df_out_h.select("POS", "COLUNA", "NATUREZA", "TIPO_DB2", "NULLABLE", "VALORES_UNICOS").show(60, truncate=False)
            
            print(f"\n🔍 PAYLOAD BRUTO HIVE (5 LINHAS):")
            df_hive_sample.limit(5).show(5, truncate=False)
            
            sumario_executivo_tabelas.append({
                "TABELA_FQN": tabela_fqn,
                "ORIGEM": "HIVE",
                "PORTE": "HIVE",
                "ESTIMATIVA_LINHAS": None,
                "QTD_COLUNAS": len(cols_hive),
                "TAMANHO_LINHA_BYTES": len(cols_hive) * 16,
                "COLUNAS_PARTICAO": "PARTITION PRUNING",
                "FETCHSIZE": 10000,
                "NPARTS": max(1, len(particoes)),
                "ESTRATEGIA": "NATIVE_SPARK_HIVE",
            })

    except Exception as exc:
        print(f"❌ Erro ao diagnosticar tabela {tabela_fqn}: {exc}")

